# Non-secret R2 publishing configuration for ph20 artifacts.
#
# Configure AWS access key material separately with `aws configure`,
# environment variables, or another secret manager. Do not store R2 secrets in
# this repository.

export R2_BUCKET="ph20-artifacts-public"
export R2_PUBLIC_BASE_URL="https://artifacts.ph20.org"
export R2_ENDPOINT_URL="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
export AWS_PROFILE="r2-ph20"
export GPG_SIGNING_KEY="<your-packages-ph20-org-key-fingerprint-or-key-id>"
